# Use lightweight Python image
FROM python:3.9-alpine

# Set environment variables to avoid Python buffer issues
ENV PYTHONUNBUFFERED=1

# Install required system dependencies
RUN apk add --no-cache git openssl graphicsmagick gcc musl-dev libffi-dev

# Set working directory inside the container
WORKDIR /home/dev/source

# Install Python dependencies directly (example: Flask, etc.)
RUN pip install --no-cache-dir Flask

# Copy the application files
COPY . .

# Expose Flask's default port (5000)
EXPOSE 5000  

# Command to start Flask (adjust for your app entry point)
CMD ["python", "backend/app.py"]
